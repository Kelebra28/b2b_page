# Formulario de contacto (app/api/contacto/route.ts) con Resend.
# Copia a .env.local (local) o cárgalo en Vercel > Settings > Environment Variables.
# 1) Crea la API key en https://resend.com/api-keys  2) Verifica el dominio laserinova.com (registros DNS SPF/DKIM).
RESEND_API_KEY=
# Remitente: debe ser una dirección del dominio verificado.
CONTACT_FROM=no-reply@laserinova.com
# Dónde llegan las solicitudes.
CONTACT_TO=informes@laserinova.com

# SOLO en staging (Vercel, entorno de pruebas): evita que Google indexe la copia. NO ponerlo en producción.
# SITE_NOINDEX=1

# Número de los botones de WhatsApp (por defecto el bot: 525544730004). Para volver al teléfono principal: 525579398727
# NEXT_PUBLIC_WHATSAPP_NUMBER=525544730004

# Tienda (/tienda): API pública de solo lectura del CRM. Solo servidor, nunca NEXT_PUBLIC_.
# CATALOG_API_URL=https://app.laserinova.com
# CATALOG_API_KEY=
