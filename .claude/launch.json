{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sitio-local",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "next-web",
      "runtimeExecutable": "npm",
